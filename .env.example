# Copy to .env (never committed) and fill in your own values.

# DeepSeek API key (required).
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek API base URL (default https://api.deepseek.com).
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Bearer token clients must send; required for --transport streamable-http only.
MCP_BEARER_TOKEN=

# Optional: in-memory response cache, 1 = on (default), 0 = off.
# DEEPSEEK_MCP_CACHE=1

# Optional: stderr log level for the server, the MCP SDK and uvicorn,
# one of DEBUG, INFO, WARNING (default), ERROR, CRITICAL.
# DEEPSEEK_MCP_LOG_LEVEL=WARNING

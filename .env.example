# Copy to .env (never committed) and fill in your own values.

# DeepSeek API key (required).
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek API base URL (default https://api.deepseek.com).
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Bearer token clients must send; required for --transport streamable-http only.
MCP_BEARER_TOKEN=

# Optional: in-memory response cache, 1 = on (default), 0 = off.
# DEEPSEEK_MCP_CACHE=1

# Optional: stderr log level for the server, the MCP SDK and uvicorn,
# one of DEBUG, INFO, WARNING (default), ERROR, CRITICAL.
# DEEPSEEK_MCP_LOG_LEVEL=WARNING

# Optional: daily spending limit in USD (e.g. 5.00); blocks requests with budget_exceeded when hit.
# DEEPSEEK_DAILY_BUDGET_USD=5.00

# Optional: directory for state files (defaults to ~/.cache/deepseek-search-everywhere-mcp).
# DEEPSEEK_STATE_DIR=~/.cache/deepseek-search-everywhere-mcp

# Optional: legacy key fallback, path to an opencode auth.json ({"deepseek": {"key": "..."}}),
# used only when DEEPSEEK_API_KEY is unset (default ~/.local/share/opencode/auth.json).
# DEEPSEEK_AUTH_JSON=~/.local/share/opencode/auth.json

# Optional: hosts research never uses as sources, comma-separated; `none` disables (default *.ezproxy.*).
# DEEPSEEK_SOURCE_DENYLIST=*.ezproxy.*

# Optional: restrict or block fetch targets, comma-separated domains (subdomains included).
# DEEPSEEK_FETCH_ALLOW_DOMAINS=
# DEEPSEEK_FETCH_DENY_DOMAINS=

# Optional: also reject queries/URL paths containing long high-entropy tokens (1/true/yes).
# DEEPSEEK_EGRESS_ENTROPY_CHECK=0
